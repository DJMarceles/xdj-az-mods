#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# shellcheck shell=busybox
# az-modupdate: update the mods on the stick from the deck, over WiFi.
#   az-modupdate check    newest mods-v* release on the channel vs what this stick runs
#   az-modupdate update   download it, verify every file, write MODS/ (no restart: the
#                         loader stages it and the DJ reloads, see az-usbload RESTART POLICY)
#   az-modupdate staged   the loader staged an installed set that waits for a Reload
# Runs under az-usbload's request watcher (usr/sbin/az-usbload, modupdate_watch),
# never inside EP147. The watcher passes the pick: AZ_MNT (stock mount), AZ_MODS.
#
# Trust: the same minisign key the desktop app embeds (AZ_PUB below, key id
# 5B07109A2F3C24FE). A mods-v release is four assets: manifest.json (+.minisig,
# the root of trust) and mods-v<ver>.tar.gz (+.minisig, the whole set in the
# manifest's layout). Nothing is written to the stick until the manifest's
# signature, the archive's signature (minisign hashed mode: Ed25519 over
# BLAKE2b-512, plus the global signature over sig||trusted-comment) and every
# sha256 pin in the manifest have all passed. The stock deck has curl (TLS, CA bundle)
# and openssl 3.0, which is all the verification needs. No jq, no base64 binary: awk +
# openssl base64.
#
# Status: /tmp/az-modupdate/status, key=value, rewritten whole on every change:
#   state   idle|checking|uptodate|available|downloading|verifying|installing|installed|error|offline
#           (installed: written to the stick, waiting for a Reload)
#   local   the set this stick runs (MODS/deck/version)
#   remote  newest channel version ("" when unknown)
#   done/total  files fetched+verified so far / in the set
#   msg     one human line (always last)
# azmod's Update Mods screen renders this file; it never talks to the network.
set -u
# Which repo: the same pointer the desktop app follows:
# channel.json in the app repo names the mods repo, so the channel can move
# without a mods or app release. Fallback is the dedicated channel repo. The
# pointer is metadata only; trust is the embedded key below, never the pointer.
# What a redirected pointer (or a compromised channel repo) can still do: serve no
# release (no update), or serve old, genuinely signed sets under a newer tag. The
# second is refused in update(): the version is read from the signed manifest and
# must be newer than this stick's.
POINTER=${AZ_MODS_POINTER:-https://raw.githubusercontent.com/Kyle-Hosman/xdj-az-mods/main/channel.json}
REPO=${AZ_MODS_REPO:-Kyle-Hosman/az-mods-updates}
repo_from_pointer(){
    p=$(curl -sS -m 10 -H 'User-Agent: AZ-MODS-deck' "$POINTER" 2>/dev/null) || return 0
    r=$(echo "$p" | sed -n 's/.*"repo": *"\([A-Za-z0-9_.-]*\/[A-Za-z0-9_.-]*\)".*/\1/p' | head -1)
    [ -n "$r" ] && REPO=$r
    return 0
}
# only the network requests need the pointer
case "${1:-check}" in check|update) [ -n "${AZ_MODS_REPO:-}" ] || repo_from_pointer ;; esac
API=${AZ_MODS_API:-https://api.github.com/repos/$REPO/releases?per_page=30}
DL=${AZ_MODS_DL:-https://github.com/$REPO/releases/download}
AZ_PUB=${AZ_MODS_PUB:-RWT+JDwvmhAHW7mlYdLaNSuBFujiADXEbi9OYnvdJbjRTPYFCTgaio+D}
PING=${AZ_MODS_PING:-https://github.com}   # reachability probe (overridable for an emulator without DNS)
ST=/tmp/az-modupdate; STATUS=$ST/status; LOG=$ST/log; STAGE=$ST/stage
MNT=${AZ_MNT:-}; MODS=${AZ_MODS:-}
mkdir -p "$ST"
azlog_cap() { return 0; }   # replaced below by deck/lib/az-logcap.sh, the shared cap
for _azl_f in "${0%/*}/az-logcap.sh" "${0%/*}/../lib/az-logcap.sh" "${0%/*}/lib/az-logcap.sh" \
    /tmp/az-deck/lib/az-logcap.sh; do
    # shellcheck source=az-logcap.sh
    [ -f "$_azl_f" ] && { . "$_azl_f"; break; }
done
log(){ azlog_cap "$LOG"; echo "[modupdate $(date '+%H:%M:%S' 2>/dev/null || echo -n)] $*" >> "$LOG" 2>/dev/null; return 0; }
LOCAL=""; REMOTE=""; DONE=0; TOTAL=0
status(){   # $1 state, $2 msg
    { printf 'state=%s\nlocal=%s\nremote=%s\ndone=%s\ntotal=%s\nmsg=%s\n' "$1" "$LOCAL" "$REMOTE" "$DONE" "$TOTAL" "$2"; } > "$STATUS.new" 2>/dev/null
    mv -f "$STATUS.new" "$STATUS" 2>/dev/null; log "$1: $2"; return 0
}
fail(){ status error "$1"; rm -rf "$STAGE"; exit 0; }   # never a non-zero exit: the watcher must not die

[ -n "$MNT" ] && [ -d "$MODS" ] || { status error "no mods stick"; exit 0; }
LOCAL=$(tr -d '\r\n' < "$MODS/deck/version" 2>/dev/null)
vnum(){ echo "$1" | awk -F. '{printf "%d%03d%03d", $1, $2, $3}'; }   # 1.0.10 > 1.0.9

# ---- the channel: newest mods-v<semver> that is not a draft ----------------
# newest published mods-v version on the channel. Reads each release's tag_name and draft in
# document order (GitHub puts tag_name before draft in every release object); it does not
# split the pretty-printed JSON into objects. Returns 2 when GitHub rate-limits the deck
# (60 unauthenticated requests/hour per IP, shared by every device on the network).
newest(){
    j=$(curl -sS -m 20 -H 'Accept: application/vnd.github+json' -H 'User-Agent: AZ-MODS-deck' -w '\n%{http_code}' "$API" 2>>"$LOG") || return 1
    code=$(printf '%s\n' "$j" | tail -n 1); j=$(printf '%s\n' "$j" | sed '$d')
    case "$code" in 403|429) return 2 ;; esac
    case "$j" in *"rate limit exceeded"*) return 2 ;; esac
    [ -n "$j" ] || return 1
    printf '%s\n' "$j" | grep -oE '"(tag_name|draft)": *("[^"]*"|true|false)' \
      | awk -F'": *' '/"tag_name"/{t=$2; gsub(/"/,"",t); next}
                      /"draft"/{ if(t ~ /^mods-v[0-9]+\.[0-9]+\.[0-9]+$/ && $2=="false") print substr(t,7); t="" }' \
      | sort -t. -k1,1n -k2,2n -k3,3n | tail -1
}
# The newest release's changelog (a signed asset: CHANGELOG.txt + .minisig, the same key as
# the set), so the Update Mods screen shows what an update brings before it is installed.
# Verified, size-capped, written whole (tmp + mv). A release without it leaves the screen on
# the installed set's changelog. Never fatal.
fetch_changelog(){
    [ -n "$REMOTE" ] || return 0
    b="$DL/mods-v$REMOTE"; t="$ST/cl.$$"
    curl -fsSL -m 20 --max-filesize 131072 -H 'User-Agent: AZ-MODS-deck' -o "$t" "$b/CHANGELOG.txt" 2>>"$LOG" \
      && curl -fsSL -m 20 --max-filesize 4096 -H 'User-Agent: AZ-MODS-deck' -o "$t.minisig" "$b/CHANGELOG.txt.minisig" 2>>"$LOG" \
      || { rm -f "$t" "$t.minisig"; log "changelog: none for v$REMOTE"; return 0; }
    mkpub && verify "$t" "$t.minisig" || { rm -f "$t" "$t.minisig"; log "changelog: v$REMOTE signature REFUSED"; return 0; }
    mv -f "$t" "$ST/CHANGELOG.txt"; rm -f "$t.minisig"; log "changelog: v$REMOTE"
    return 0
}
check(){
    status checking "checking the mods channel..."
    if ! curl -sS -m 10 -o /dev/null "$PING" 2>>"$LOG"; then status offline "no internet (WiFi?)"; return 1; fi
    REMOTE=$(newest); rc=$?
    [ $rc = 2 ] && { REMOTE=""; status error "GitHub is busy right now, try again in a few minutes"; return 1; }
    [ $rc = 0 ] || { REMOTE=""; status error "cannot read the channel"; return 1; }
    [ -n "$REMOTE" ] || { status error "no mods release on the channel"; return 1; }
    fetch_changelog
    if [ -n "$LOCAL" ] && [ "$(vnum "$REMOTE")" -le "$(vnum "$LOCAL")" ]; then
        status uptodate "mods $LOCAL are up to date"; return 1
    fi
    status available "v$REMOTE available (this stick: ${LOCAL:-unknown})"; return 0
}

# ---- minisign verify with openssl only -------------------------------------
PUBPEM=$ST/pub.pem
mkpub(){
    { printf '\060\052\060\005\006\003\053\145\160\003\041\000'; echo "$AZ_PUB" | openssl base64 -d | tail -c 32; } > "$ST/pub.der"
    openssl pkey -pubin -inform DER -in "$ST/pub.der" -out "$PUBPEM" 2>>"$LOG"
}
verify(){   # $1 file, $2 .minisig -> 0 ok
    [ -s "$1" ] && [ -s "$2" ] || return 1
    b64=$(sed -n 2p "$2"); cmt=$(sed -n 3p "$2"); g64=$(sed -n 4p "$2")
    echo "$b64" | openssl base64 -d > "$ST/sig.blob" 2>/dev/null || return 1
    [ "$(wc -c < "$ST/sig.blob")" = 74 ] || return 1
    tail -c 64 "$ST/sig.blob" > "$ST/sig.bin"
    case "$cmt" in *hashed) openssl dgst -blake2b512 -binary "$1" > "$ST/msg.bin" ;; *) cp "$1" "$ST/msg.bin" ;; esac
    openssl pkeyutl -verify -pubin -inkey "$PUBPEM" -rawin -in "$ST/msg.bin" -sigfile "$ST/sig.bin" >/dev/null 2>>"$LOG" || return 1
    # global signature: ed25519(sig64 || trusted comment without its prefix)
    { cat "$ST/sig.bin"; printf '%s' "${cmt#trusted comment: }"; } > "$ST/gmsg.bin"
    echo "$g64" | openssl base64 -d > "$ST/gsig.bin" 2>/dev/null || return 1
    openssl pkeyutl -verify -pubin -inkey "$PUBPEM" -rawin -in "$ST/gmsg.bin" -sigfile "$ST/gsig.bin" >/dev/null 2>>"$LOG"
}
fetch(){ curl -sSL -m 300 --retry 2 -H 'User-Agent: AZ-MODS-deck' -o "$2" "$1" 2>>"$LOG"; }

update(){
    check || return 0
    V=$REMOTE; BASE="$DL/mods-v$V"
    rm -rf "$STAGE"; mkdir -p "$STAGE"
    mkpub || fail "cannot load the signing key"
    status downloading "downloading v$V manifest"
    fetch "$BASE/manifest.json" "$STAGE/manifest.json" && fetch "$BASE/manifest.json.minisig" "$STAGE/manifest.json.minisig" \
        || fail "download failed (manifest)"
    verify "$STAGE/manifest.json" "$STAGE/manifest.json.minisig" || fail "manifest signature REFUSED"
    # The version comes from the signed manifest, never from the tag: a tag is only a name
    # anyone with the channel repo (or a redirected pointer) can put on an old genuine set.
    # It must be the version asked for, and newer than what this stick runs: no rollback.
    MV=$(sed -n 's/^ *"version": *"\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' "$STAGE/manifest.json" | head -1)
    [ -n "$MV" ] || fail "the signed manifest names no version"
    [ "$MV" = "$V" ] || fail "the release says v$V but its signed manifest is v$MV: REFUSED"
    if [ -n "$LOCAL" ] && [ "$(vnum "$MV")" -le "$(vnum "$LOCAL")" ]; then
        fail "the signed set is v$MV, not newer than this stick's $LOCAL: REFUSED (no downgrade)"
    fi
    # the file list: name / sha256 / dir per file object (pretty-printed JSON, one key per line).
    # Every object keeps its own keys, so nothing carries into the next one; a file's dir is
    # its own, else the nearest enclosing object's (its entry's), as the app reads it.
    awk 'function val(s) { sub(/^[^:]*: *"/, "", s); sub(/".*/, "", s); return s }
         /^[ \t]*\{[ \t]*$/ || /: *\{[ \t]*$/ { k++; nm[k] = ""; sh[k] = ""; dr[k] = ""; next }
         /^[ \t]*\},?[ \t]*$/ {
             if (k > 0 && sh[k] != "") {
                 d = dr[k]
                 for (i = k - 1; d == "" && i > 0; i--) d = dr[i]
                 print (d == "" ? nm[k] : d "/" nm[k]), sh[k]
             }
             if (k > 0) k--
             next
         }
         /"name":/ { nm[k] = val($0) }
         /"sha256":/ { sh[k] = val($0) }
         /"dir":/ { dr[k] = val($0) }' "$STAGE/manifest.json" > "$STAGE/files"
    TOTAL=$(wc -l < "$STAGE/files" | tr -d ' '); [ "$TOTAL" -gt 0 ] || fail "manifest names no files"
    case "$(cat "$STAGE/files")" in *"azmod.so "*|*"azmod-core.so "*) ;; *) fail "manifest has no core mod" ;; esac
    # the set: one archive, signed, then every file pinned by the signed manifest
    TGZ="mods-v$V.tar.gz"
    status downloading "v$V: $TGZ"
    fetch "$BASE/$TGZ" "$STAGE/$TGZ" && fetch "$BASE/$TGZ.minisig" "$STAGE/$TGZ.minisig" || fail "download failed ($TGZ)"
    status verifying "v$V: archive signature"
    verify "$STAGE/$TGZ" "$STAGE/$TGZ.minisig" || fail "archive signature REFUSED"
    mkdir -p "$STAGE/set" && tar -C "$STAGE/set" -xzf "$STAGE/$TGZ" 2>>"$LOG" || fail "archive does not unpack"
    DONE=0
    while read -r rel sha; do
        status verifying "v$V: $rel"
        [ -f "$STAGE/set/$rel" ] || fail "archive is missing $rel"
        [ "$(sha256sum "$STAGE/set/$rel" | cut -d' ' -f1)" = "$sha" ] || fail "sha256 mismatch: $rel"
        DONE=$((DONE + 1))
    done < "$STAGE/files"
    # everything verified: now, and only now, the stick. Remount rw only if ro.
    status installing "writing v$V to the USB"
    ro=$(awk -v m="$MNT" '$2==m{print ($4 ~ /(^|,)ro(,|$)/)?1:0; exit}' /proc/mounts 2>/dev/null)
    [ "$ro" = 1 ] && { mount -o remount,rw "$MNT" 2>>"$LOG" || fail "USB is read-only"; }
    ok=1
    while read -r rel sha; do
        mkdir -p "$MODS/$(dirname "$rel")" 2>>"$LOG"
        if cp -f "$STAGE/set/$rel" "$MODS/$rel.new" 2>>"$LOG" && mv -f "$MODS/$rel.new" "$MODS/$rel" 2>>"$LOG"; then :
        else ok=0; log "write failed: $rel"; break; fi
    done < "$STAGE/files"
    # deck/: exactly the set (a renamed hook must not linger), the same rule as the app's install()
    if [ "$ok" = 1 ] && [ -d "$MODS/deck" ]; then
        find "$MODS/deck" -type f | while read -r f; do
            # the path compared as a string: as a pattern, "v.rsion" would also match "version"
            r=${f#"$MODS"/}; R=$r awk '$1 == ENVIRON["R"] { f = 1; exit } END { exit !f }' "$STAGE/files" ||
                { rm -f "$f"; log "removed stale $r"; }
        done
    fi
    sync
    [ "$ro" = 1 ] && mount -o remount,ro "$MNT" 2>/dev/null
    [ "$ok" = 1 ] || fail "could not write the USB (a partial set is on it: re-run, or use the app)"
    rm -rf "$STAGE"
    LOCAL=$V
    # No restart from here: the loader re-runs, stages the set and leaves EP147 running.
    status installed "Update installed. Reload to apply."
    return 0
}
# After the loader staged an installed set without restarting EP147. "uptodate" is the
# state every Update Mods screen treats as final (an older azmod still running shows
# "Up to date"); a current azmod sees the loader's /run/az-reload-pending and shows
# "Update installed. Reload to apply."
staged(){
    REMOTE=$LOCAL
    status uptodate "Update installed. Reload to apply."
}

case "${1:-check}" in
    check)  check; exit 0 ;;
    update) update; exit 0 ;;
    staged) staged; exit 0 ;;
    *) status error "unknown request $1"; exit 0 ;;
esac
